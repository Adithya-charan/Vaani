# Copy to .env and fill in. Never commit .env.

# Random shared secret the phone sends as "Authorization: Bearer <token>".
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
VAANI_AUTH_TOKEN=

# Comma-separated IPs to listen on. 127.0.0.1 = this laptop only.
# For the phone, add the laptop's Tailscale IP (100.x.y.z) and/or its home Wi-Fi IP.
# Addresses that are not up at start-up are skipped.
VAANI_HOST=127.0.0.1
VAANI_PORT=8765

# Optional: client networks allowed to talk to the agent at all (CIDRs, comma-separated).
# Default: loopback, home/private ranges and Tailscale.
# VAANI_ALLOWED_CLIENTS=192.168.0.0/24,100.64.0.0/10

# Comma-separated. Known names (Documents, Desktop, Downloads) or Alias=C:\absolute\path
VAANI_APPROVED_FOLDERS=Documents,Desktop,Downloads

# Optional: AI planning (Groq)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: voice (Sarvam) - used from a later phase
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
